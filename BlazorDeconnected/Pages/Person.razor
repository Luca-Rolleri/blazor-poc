@using BlazorDeconnected.Models;
@using BlazorDeconnected.Services;

@page "/person";
@inject OfflineStore Store;
@inject NetworkStatusService Net;
@inject FormsService Forms;

<h3>Person</h3>


<h3>Personne</h3>

@if (!_online)
{
    <div class="offline-banner">Mode déconnecté</div>
}

<EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Nom complet</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_model.Email" />
    </div>

    <button class="btn btn-primary" type="submit">Envoyer</button>
    <button class="btn btn-secondary ms-2" type="button" @onclick="SaveDraftAsync">Sauvegarder le brouillon</button>
</EditForm>

@code {
    private PersonDto _model = new();
    private bool _online = true;
    private const string DraftKey = "person-form";

    protected override async Task OnInitializedAsync()
    {
        Net.Changed += b => { _online = b; StateHasChanged(); };
        await Net.InitializeAsync();

        var draft = await Store.GetDraftAsync(DraftKey);
        if (draft is not null)
            _model = System.Text.Json.JsonSerializer.Deserialize<PersonDto>(draft.JsonData) ?? new PersonDto();
    }

    private async Task SaveDraftAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_model);
        await Store.SaveDraftAsync(DraftKey, json);
    }

    private async Task SubmitAsync() => await Forms.SubmitPersonAsync(_model);
}

